import Base
import ./flow.bend as Flow

# Human claims, checked on the example traces in flow.bend (not for all traces). Proofs live in PROOF.bend and do not edit this file.
# No merge without a fresh review. Irreversible acts stay outside a flow.
# A result card follows a fresh verifier. In capture-sweep only the final step writes.

law flows_hold:
  {Flow.bundle() == ((1n, 1n), (1n, 1n)) : (Nat & Nat) & (Nat & Nat)}

law capture_holds:
  {Flow.capture_pair() == (1n, 1n) : Nat & Nat}

law merge_needs_verdict:
  {Flow.merge_pair() == (0n, 1n) : Nat & Nat}

law irreversible_blocked:
  {Flow.harm() == ((1n, 1n), (1n, 0n)) : (Nat & Nat) & (Nat & Nat)}

law early_write_blocked:
  {Flow.writes_ok(Flow.early_write()) == 0n : Nat}

law write_makes_verify_stale:
  {Flow.stale_pair() == (0n, 0n) : Nat & Nat}

law irreversible_never_clean:
  {Flow.irreversible_clean() == ((0n, 0n), (0n, 0n)) : (Nat & Nat) & (Nat & Nat)}
