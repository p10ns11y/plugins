#!/usr/bin/env python3
"""Classify open pull requests by age, even when nothing new happened.

Input: JSON from `gh pr list --json number,title,isDraft,createdAt,updatedAt,
mergeable,reviewDecision,statusCheckRollup,labels` on stdin or --file PATH.
Output: one JSON object per line. Read only: it never closes or merges.

First rule that fits wins:
  frozen / user-decision label or FROZEN=1   -> blocked-on-user (ask once, then 7d)
  conflict / failing checks / changes asked  -> resume
  needs-reviewer label (party not available) -> blocked-on-party (ask after 72h)
  idle >= 7 days                             -> propose-close (never auto-close)
  green and unblocked                        -> resume
"""

import json
import os
import sys
from datetime import datetime, timezone

USER_LABELS = {"frozen", "user-decision", "blocked-on-user", "needs-user"}
PARTY_LABELS = {"needs-reviewer", "cross-family-review", "blocked-on-party"}
GOOD_CHECKS = {"SUCCESS", "NEUTRAL", "SKIPPED"}
BAD_CHECKS = {"FAILURE", "ERROR", "CANCELLED", "TIMED_OUT", "ACTION_REQUIRED", "STARTUP_FAILURE", "STALE"}


def stamp(raw, now):
    try:
        then = datetime.strptime(raw, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
    except (TypeError, ValueError):
        return None
    return (now - then).total_seconds() / 3600.0


def checks_failing(rollup):
    for item in rollup or []:
        state = (item.get("conclusion") or item.get("state") or "").upper()
        if state in BAD_CHECKS:
            return True
    return False


def checks_green(rollup):
    states = [(i.get("conclusion") or i.get("state") or "").upper() for i in rollup or []]
    return bool(states) and all(st in GOOD_CHECKS for st in states)


def classify(pr, now, frozen=False):
    labels = {(lab.get("name") or "").lower() for lab in pr.get("labels") or []}
    idle_h = stamp(pr.get("updatedAt"), now)
    age_h = stamp(pr.get("createdAt"), now)
    idle_d = None if idle_h is None else idle_h / 24.0
    out = {
        "number": pr.get("number"),
        "title": pr.get("title", ""),
        "draft": bool(pr.get("isDraft")),
        "age_days": None if age_h is None else round(age_h / 24.0, 1),
        "idle_days": None if idle_d is None else round(idle_d, 1),
    }
    if frozen or labels & USER_LABELS:
        out.update(state="blocked-on-user", action="ask once; re-ask after 7 days")
    elif (pr.get("mergeable") == "CONFLICTING" or checks_failing(pr.get("statusCheckRollup"))
          or pr.get("reviewDecision") == "CHANGES_REQUESTED"):
        out.update(state="resume", action="fix conflicts, checks or requested changes next session")
    elif labels & PARTY_LABELS:
        due = idle_h is not None and idle_h >= 72
        out.update(state="blocked-on-party",
                   action="ask one yes/no now" if due else "name the blocker; ask after 72h")
    elif idle_d is not None and idle_d >= 7:
        out.update(state="propose-close", action="draft a close note for approval; never auto-close")
    else:
        if not checks_green(pr.get("statusCheckRollup")) or pr.get("mergeable") != "MERGEABLE":
            out.update(state="resume", action="checks pending or mergeability unknown: re-check next session")
        elif out["draft"]:
            out.update(state="resume", action="green and unblocked: mark ready for review")
        elif pr.get("reviewDecision") == "REVIEW_REQUIRED":
            out.update(state="resume", action="green: get the required review, then merge")
        else:
            out.update(state="resume", action="green and unblocked: merge when allowed")
    return out


def main(argv):
    path = None
    if len(argv) == 2 and argv[0] == "--file":
        path = argv[1]
    elif argv:
        print("usage: pr-triage [--file PATH]", file=sys.stderr)
        return 2
    if path:
        with open(path, encoding="utf-8") as fh:
            raw = fh.read()
    else:
        raw = sys.stdin.read()
    rows = json.loads(raw)
    if not isinstance(rows, list):
        return 2
    now_raw = os.environ.get("TRIAGE_NOW")
    try:
        now = (datetime.strptime(now_raw, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
               if now_raw else datetime.now(timezone.utc))
    except ValueError:
        print("bad TRIAGE_NOW", file=sys.stderr)
        return 2
    frozen = os.environ.get("FROZEN") == "1"
    for pr in rows:
        print(json.dumps(classify(pr, now, frozen)))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
