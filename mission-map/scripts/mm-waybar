#!/usr/bin/env python3
"""Waybar chip: next mission act. Reads ~/.grok/mission-maps/waybar.json."""
from __future__ import annotations

import json
import os
import sys
from pathlib import Path

MAPS = Path(os.environ.get("MISSION_MAPS", Path.home() / ".grok" / "mission-maps"))
CHIP = MAPS / "waybar.json"

# Product window only. Substring "kanithanj.ai" in a terminal/browser title
# (e.g. this Grok session) must not steal Apply.
PRODUCT_CLASSES = ("kanithanj.ai", "com.p10ns11y.collab-finder")
DEV_WINDOW_TITLE = "collab-finder"


def main() -> int:
    if len(sys.argv) > 1 and sys.argv[1] == "self-test":
        return run_self_test()
    if len(sys.argv) > 1 and sys.argv[1] == "notify":
        payload = load()
        tip = payload.get("tooltip") or payload.get("text") or "No mission map"
        title = "Do this: " + (payload.get("text") or "next")
        os.execvp(
            "notify-send",
            [
                "notify-send",
                "--urgency=normal",
                "--expire-time=20000",
                "--app-name=Mission map",
                "--icon=appointment-soon",
                title,
                tip,
            ],
        )
    if len(sys.argv) > 1 and sys.argv[1] == "open":
        MAPS.mkdir(parents=True, exist_ok=True)
        (MAPS / "open-route").write_text("heading\n", encoding="utf-8")
        return launch_collab_finder()
    sys.stdout.write(json.dumps(load(), ensure_ascii=False) + "\n")
    return 0


def load() -> dict:
    try:
        return json.loads(CHIP.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {
            "text": "Map?",
            "tooltip": "Run mm-lifeos-graph",
            "class": "empty",
        }


def hypr_clients() -> list[dict]:
    import subprocess

    try:
        out = subprocess.run(
            ["hyprctl", "clients", "-j"],
            check=False,
            capture_output=True,
            text=True,
        )
        data = json.loads(out.stdout or "[]")
        return data if isinstance(data, list) else []
    except (OSError, json.JSONDecodeError):
        return []


def is_product_window(client: dict) -> bool:
    """Installed app only — not Vite debug, not a terminal whose title mentions it."""
    title = str(client.get("title") or "")
    if title == DEV_WINDOW_TITLE:
        return False
    for field in ("class", "initialClass"):
        klass = str(client.get(field) or "")
        if klass in PRODUCT_CLASSES:
            return True
    return title == "kanithanj.ai"


def find_product_address(clients: list[dict]) -> str | None:
    for client in clients:
        if not is_product_window(client):
            continue
        addr = client.get("address")
        if addr:
            return str(addr)
    return None


def resolve_kanithanj() -> str | None:
    """PATH first (~/.local/bin prepended). Waybar's env often omits it."""
    import shutil

    local = Path.home() / ".local" / "bin"
    path = os.environ.get("PATH", "")
    parts = path.split(os.pathsep) if path else []
    if str(local) not in parts:
        os.environ["PATH"] = str(local) + os.pathsep + path
    found = shutil.which("kanithanj.ai")
    if found:
        return found
    fallback = local / "kanithanj.ai"
    if fallback.is_file() and os.access(fallback, os.X_OK):
        return str(fallback)
    return None


def launch_collab_finder() -> int:
    """Focus running product, else `kanithanj.ai` on PATH. Never open notes."""
    import subprocess

    addr = find_product_address(hypr_clients())
    if addr:
        subprocess.run(
            ["hyprctl", "dispatch", "focuswindow", f"address:{addr}"],
            check=False,
            capture_output=True,
        )
        return 0

    exe = resolve_kanithanj()
    if not exe:
        subprocess.run(
            [
                "notify-send",
                "--urgency=critical",
                "--app-name=Mission map",
                "kanithanj.ai not on PATH",
                "Install with: pnpm install:local",
            ],
            check=False,
        )
        return 1

    # Hyprland must exec the window; a bare Popen from Waybar often never maps.
    ran = subprocess.run(
        ["hyprctl", "dispatch", "exec", exe],
        check=False,
        capture_output=True,
        text=True,
    )
    if ran.returncode != 0:
        subprocess.Popen([exe], start_new_session=True)
    return 0


def run_self_test() -> int:
    debug_only = [
        {
            "address": "0xdebug",
            "class": "collab-finder",
            "initialClass": "collab-finder",
            "title": "collab-finder",
        }
    ]
    product = [
        {
            "address": "0xprod",
            "class": "collab-finder",
            "initialClass": "collab-finder",
            "title": "kanithanj.ai",
        }
    ]
    grok_term = [
        {
            "address": "0xgrok",
            "class": "com.mitchellh.ghostty",
            "initialClass": "com.mitchellh.ghostty",
            "title": "Fortress ranker v1 in kanithanj.ai - grok",
        }
    ]
    mixed = debug_only + product
    assert find_product_address(debug_only) is None, "must skip debug Vite window"
    assert find_product_address(grok_term) is None, "must not focus a terminal that mentions the app"
    assert find_product_address(product) == "0xprod"
    assert find_product_address(mixed) == "0xprod"
    resolved = resolve_kanithanj()
    assert resolved and resolved.endswith("kanithanj.ai"), resolved
    sys.stdout.write("mm-waybar self-test ok\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
