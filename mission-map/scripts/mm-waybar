#!/usr/bin/env python3
"""Waybar chip: next mission act. Reads ~/.grok/mission-maps/waybar.json."""
from __future__ import annotations

import json
import os
import sys
from pathlib import Path

MAPS = Path(os.environ.get("MISSION_MAPS", Path.home() / ".grok" / "mission-maps"))
CHIP = MAPS / "waybar.json"
CF_CLASS_NEEDLES = ("kanithanj.ai", "collab-finder", "com.p10ns11y.collab-finder")


def main() -> int:
    if len(sys.argv) > 1 and sys.argv[1] == "notify":
        payload = load()
        tip = payload.get("tooltip") or payload.get("text") or "No mission map"
        title = "Do this: " + (payload.get("text") or "next")
        os.execvp(
            "notify-send",
            [
                "notify-send",
                "--urgency=normal",
                "--expire-time=20000",
                "--app-name=Mission map",
                "--icon=appointment-soon",
                title,
                tip,
            ],
        )
    if len(sys.argv) > 1 and sys.argv[1] == "open":
        MAPS.mkdir(parents=True, exist_ok=True)
        (MAPS / "open-route").write_text("heading\n", encoding="utf-8")
        return launch_collab_finder()
    sys.stdout.write(json.dumps(load(), ensure_ascii=False) + "\n")
    return 0


def load() -> dict:
    try:
        return json.loads(CHIP.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {
            "text": "Map?",
            "tooltip": "Run mm-lifeos-graph",
            "class": "empty",
        }


def hypr_clients() -> list[dict]:
    import subprocess

    try:
        out = subprocess.run(
            ["hyprctl", "clients", "-j"],
            check=False,
            capture_output=True,
            text=True,
        )
        data = json.loads(out.stdout or "[]")
        return data if isinstance(data, list) else []
    except (OSError, json.JSONDecodeError):
        return []


def find_cf_address() -> str | None:
    for client in hypr_clients():
        blob = " ".join(
            str(client.get(k) or "")
            for k in ("class", "initialClass", "title")
        )
        if any(n in blob for n in CF_CLASS_NEEDLES):
            addr = client.get("address")
            if addr:
                return str(addr)
    return None


def launch_collab_finder() -> int:
    """Focus running CF or start one binary. Never spawn a second window."""
    import subprocess

    addr = find_cf_address()
    if addr:
        subprocess.run(
            ["hyprctl", "dispatch", "focuswindow", f"address:{addr}"],
            check=False,
            capture_output=True,
        )
        return 0

    home = Path.home()
    candidates = [
        home / "Work/personal/collab-finder/src-tauri/target/debug/collab-finder",
        home / ".local/bin/kanithanj.ai",
        home / "Work/personal/collab-finder/src-tauri/target/release/collab-finder",
    ]
    for bin in candidates:
        if bin.is_file() and os.access(bin, os.X_OK):
            subprocess.Popen([str(bin)], start_new_session=True)
            return 0
    note = home / "life-os" / "UI" / "_private.Mission.md"
    if not note.is_file():
        note = home / "life-os" / "UI" / "Mission.md"
    os.execvp("xdg-open", ["xdg-open", str(note)])
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
