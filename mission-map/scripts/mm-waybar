#!/usr/bin/env python3
"""Waybar chip: next mission act. Reads ~/.grok/mission-maps/waybar.json."""
from __future__ import annotations

import json
import os
import sys
from pathlib import Path

MAPS = Path(os.environ.get("MISSION_MAPS", Path.home() / ".grok" / "mission-maps"))
CHIP = MAPS / "waybar.json"


def main() -> int:
    if len(sys.argv) > 1 and sys.argv[1] == "notify":
        payload = load()
        tip = payload.get("tooltip") or payload.get("text") or "No mission map"
        title = "Do this: " + (payload.get("text") or "next")
        os.execvp(
            "notify-send",
            [
                "notify-send",
                "--urgency=normal",
                "--expire-time=20000",
                "--app-name=Mission map",
                "--icon=appointment-soon",
                title,
                tip,
            ],
        )
    if len(sys.argv) > 1 and sys.argv[1] == "open":
        MAPS.mkdir(parents=True, exist_ok=True)
        (MAPS / "open-route").write_text("heading\n", encoding="utf-8")
        return launch_collab_finder()
    sys.stdout.write(json.dumps(load(), ensure_ascii=False) + "\n")
    return 0


def load() -> dict:
    try:
        return json.loads(CHIP.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {
            "text": "Map?",
            "tooltip": "Run mm-lifeos-graph",
            "class": "empty",
        }


def launch_collab_finder() -> int:
    """Focus running CF or start the debug/release binary. Cluster: open is free."""
    import subprocess

    focused = subprocess.run(
        ["hyprctl", "dispatch", "focuswindow", "class:^(collab-finder)$"],
        check=False,
        capture_output=True,
    )
    if focused.returncode == 0 and b"ok" in (focused.stdout + focused.stderr).lower():
        return 0
    # Tauri 2 often uses the identifier as class.
    focused = subprocess.run(
        ["hyprctl", "dispatch", "focuswindow", "class:^(com.p10ns11y.collab-finder)$"],
        check=False,
        capture_output=True,
    )
    home = Path.home()
    candidates = [
        home / ".local/bin/kanithanj.ai",
        home / "Work/personal/collab-finder/src-tauri/target/release/collab-finder",
        home / "Work/personal/collab-finder/src-tauri/target/debug/collab-finder",
    ]
    for bin in candidates:
        if bin.is_file() and os.access(bin, os.X_OK):
            subprocess.Popen([str(bin)], start_new_session=True)
            return 0
    note = home / "life-os" / "UI" / "_private.Mission.md"
    if not note.is_file():
        note = home / "life-os" / "UI" / "Mission.md"
    os.execvp("xdg-open", ["xdg-open", str(note)])
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
