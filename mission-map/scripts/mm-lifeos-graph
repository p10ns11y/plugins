#!/usr/bin/env bash
# Nightly heading refresh: rewrite life-os UI/Mission.md from the live JSON map.
# Does not invent stages or rewrite a/m/b.
set -euo pipefail

MAPS="${MISSION_MAPS:-$HOME/.grok/mission-maps}"
NOW_JSON="${MISSION_MAP_NOW:-$MAPS/cash-path-now.json}"
LAST_JSON="${MISSION_MAP_LAST:-$MAPS/cash-path-last-run.json}"
LIFEOS="${LIFEOS:-${LIFE_OS:-$HOME/life-os}}"
OUT="${MISSION_MAP_OUT:-$LIFEOS/UI/Mission.md}"
LOG="${MISSION_MAP_LOG:-$MAPS/nightly.log}"

_self="${BASH_SOURCE[0]:-$0}"
if command -v readlink >/dev/null 2>&1; then
  _self="$(readlink -f -- "$_self")"
fi
ROOT="$(CDPATH= cd -- "$(dirname "$_self")/.." && pwd)"

find_graph() {
  if [ -n "${MISSION_MAP_GRAPH:-}" ] && [ -x "$MISSION_MAP_GRAPH" ]; then
    printf '%s\n' "$MISSION_MAP_GRAPH"
    return
  fi
  if [ -x "$ROOT/bin/mission-map-graph" ]; then
    printf '%s\n' "$ROOT/bin/mission-map-graph"
    return
  fi
  if [ -x "$ROOT/rust/target/release/mission-map-graph" ]; then
    printf '%s\n' "$ROOT/rust/target/release/mission-map-graph"
    return
  fi
  if [ -x "$ROOT/rust/target/debug/mission-map-graph" ]; then
    printf '%s\n' "$ROOT/rust/target/debug/mission-map-graph"
    return
  fi
  if command -v mission-map-graph >/dev/null 2>&1; then
    command -v mission-map-graph
    return
  fi
  echo "mm-lifeos-graph: mission-map-graph not found" >&2
  exit 1
}

field() {
  printf '%s\n' "$1" | awk -F= -v k="$2" '$1==k {sub(/^[^=]*=/,""); print; exit}'
}

notify() {
  local urgency="$1" title="$2" body="$3"
  if [ -z "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]; then
    return 0
  fi
  if ! command -v notify-send >/dev/null 2>&1; then
    return 0
  fi
  notify-send --urgency="$urgency" --expire-time=12000 --app-name="Mission map" \
    --icon=appointment-soon "$title" "$body" || true
}

if [ ! -f "$NOW_JSON" ]; then
  echo "mm-lifeos-graph: missing $NOW_JSON" >&2
  exit 1
fi

GRAPH="$(find_graph)"
mkdir -p "$(dirname "$OUT")" "$MAPS"

args=("$NOW_JSON" --mermaid)
if [ -f "$LAST_JSON" ]; then
  args+=(--compare "$LAST_JSON")
fi

report="$("$GRAPH" "${args[@]}")"

g="$(field "$report" g)"
critical="$(field "$report" critical)"
path_te="$(field "$report" path_te)"
next_do="$(field "$report" next_do)"
heading="$(field "$report" heading)"
cos="$(field "$report" cos)"
residual="$(field "$report" residual)"
parked="$(field "$report" parked)"
delta_te="$(field "$report" delta_te)"
completed="$(field "$report" completed)"
path_te_was="$(field "$report" path_te_was)"

mermaid="$(printf '%s\n' "$report" | awk 'f{print} /^--- mermaid$/{f=1}')"

kind="on-path"
note="Heading along û_G."
if [ "$heading" = "park" ] || [ "$cos" = "0" ]; then
  kind="deviation"
  note="cosθ=0 — this tick is orthogonal to G (Park / shiny)."
elif [ "$heading" = "wait" ]; then
  kind="wait"
  note="No self-vector. Signpost only; do not invent work."
elif [ -n "$delta_te" ]; then
  awk -v d="$delta_te" 'BEGIN { exit !(d > 0.05) }' && {
    if [ "$heading" = "on-path" ] && [ -n "$next_do" ]; then
      kind="replan"
      note="Remaining T grew (delta_te=$delta_te) after a DAG/band replan — still on û_G. Not a Park."
    else
      kind="deviation"
      note="Remaining T grew (delta_te=$delta_te). Check a new stage or a longer Wait."
    fi
  }
fi

if [ "$kind" = "on-path" ] && [ -n "$completed" ]; then
  note="Progress: completed $completed. Remaining T moved ${delta_te:-0}."
elif [ "$kind" = "on-path" ] && [ -n "$delta_te" ]; then
  awk -v d="$delta_te" 'BEGIN { exit !(d < -0.05) }' && {
    note="Remaining T shortened (delta_te=$delta_te)."
  }
fi

when="$(date +%Y-%m-%dT%H:%M:%S%z)"
day="$(date +%Y-%m-%d)"
eval "$(python3 - "$NOW_JSON" "${next_do:-}" <<'PY'
import json, os, shlex, sys

m = json.load(open(sys.argv[1]))
nid = (sys.argv[2] if len(sys.argv) > 2 else "") or ""
stages = m.get("stages") or []
by_id = {s.get("id"): s for s in stages if s.get("id")}
nxt = by_id.get(nid) or next((s for s in stages if (s.get("class") or "").lower() == "do"), None)

def esc(s):
    return (s or "").replace("|", "/")

def contact(s):
    c = s.get("contact") if isinstance(s.get("contact"), dict) else {}
    return c or {}

# Public table: no emails.
lines = ["| id | class | what | follow-up | when |", "|----|-------|------|-----------|------|"]
for s in stages:
    c = contact(s)
    lines.append(
        "| {id} | {cl} | {what} | {fu} | {when} |".format(
            id=esc(s.get("id")),
            cl=esc(s.get("class")),
            what=esc(s.get("what") or "—"),
            fu=esc(c.get("followup_stage") or "—"),
            when=esc(c.get("followup_when") or "—"),
        )
    )

act_title = "Do this now"
act_pub = "No Do on the map."
act_local = act_pub
if nxt:
    c = contact(nxt)
    what = (nxt.get("what") or nxt.get("id") or "next step").strip()
    act_title = what
    pub = [what + "."]
    if c.get("followup_stage"):
        pub.append(c["followup_stage"] + (f" ({c['followup_when']})" if c.get("followup_when") else "") + ".")
    loc = list(pub)
    if c.get("last_touch"):
        loc.append("Last: " + c["last_touch"] + ".")
    if c.get("url"):
        loc.append(c["url"])
    if c.get("email"):
        loc.append("Mail: " + c["email"])
    waits = []
    for s in stages:
        if (s.get("class") or "").lower() != "wait":
            continue
        cc = contact(s)
        if cc.get("followup_when") or cc.get("followup_stage"):
            waits.append(s)
    if waits:
        w = waits[0]
        wc = contact(w)
        extra = "Also: {what} — {fu}{when}.".format(
            what=(w.get("what") or w.get("id")),
            fu=wc.get("followup_stage") or "follow up",
            when=(" " + wc["followup_when"]) if wc.get("followup_when") else "",
        )
        pub.append(extra)
        loc.append(extra)
        if wc.get("email"):
            loc.append("Mail: " + wc["email"])
        if wc.get("url"):
            loc.append(wc["url"])
    act_pub = " ".join(pub)
    act_local = " ".join(loc)

# Local contacts file (emails OK — this path is not the public vault).
local_lines = ["# Local contacts (not for git / not for UI/Mission.md)", ""]
for s in stages:
    c = contact(s)
    if not c:
        continue
    local_lines.append("## {id} — {what}".format(id=s.get("id"), what=s.get("what") or ""))
    for k in ("followup_stage", "followup_when", "last_touch", "email", "url"):
        if c.get(k):
            local_lines.append("- {k}: {v}".format(k=k, v=c[k]))
    local_lines.append("")

out_dir = os.environ.get("MISSION_MAPS") or os.path.expanduser("~/.grok/mission-maps")
os.makedirs(out_dir, exist_ok=True)
open(os.path.join(out_dir, "contacts.md"), "w").write("\n".join(local_lines) + "\n")

print("key_table=" + shlex.quote("\n".join(lines)))
print("policy=" + shlex.quote((m.get("policy") or "").strip()))
print("act_title=" + shlex.quote(act_title))
print("act_body=" + shlex.quote(act_local))
print("act_pub=" + shlex.quote(act_pub))
PY
)"

{
  cat <<EOF
---
type: note
status: "In Progress"
importance: 4
urgency: 3
area: "[[Career]]"
tags: [mission-map, heading, nightly]
review_date: $day
---

# Mission heading

Nightly rewrite (20:00 local). Numbers from \`mission-map-graph\`. No silent a/m/b overwrite.

**Do this now:** $act_title

$act_pub

Emails and posting URLs: local \`~/.grok/mission-maps/contacts.md\` (not this page).

**Updated:** $when  
**Verdict:** **$kind**

| Field | Value |
|-------|--------|
| **G** | $g |
| **heading** | $heading |
| **cosθ** | ${cos:-—} |
| **next_do** | ${next_do:-—} |
| **critical** | $critical |
| **residual** | $residual |
| **path_te** (wk) | $path_te |
| **path_te_was** | ${path_te_was:-—} |
| **delta_te** | ${delta_te:-—} |
| **completed** | ${completed:-—} |
| **parked** | ${parked:-—} |

$note
$(if [ -n "$policy" ]; then printf '\n## Push rule\n\n%s\n' "$policy"; fi)

## Key

Ids are handles. Follow-up stage is what to do next. Emails are local-only.

$key_table

## Graph

\`\`\`mermaid
$mermaid
\`\`\`

Live JSON: \`~/.grok/mission-maps/cash-path-now.json\`. Brief: \`~/.grok/mission-maps/cash-path-now.md\`.

LLM may propose a stage. Human confirms. Do not treat this page as a destiny date.
EOF
} >"$OUT"

cp -f "$NOW_JSON" "$LAST_JSON"
printf '%s kind=%s heading=%s cos=%s next_do=%s delta_te=%s completed=%s\n' \
  "$when" "$kind" "$heading" "${cos:-}" "${next_do:-}" "${delta_te:-}" "${completed:-}" >>"$LOG"

case "$kind" in
  deviation)
    notify critical "Stop: ${act_title:-off path}" "${act_body:-$note}"
    ;;
  wait)
    notify low "Waiting: ${act_title:-no Do}" "${act_body:-$note}"
    ;;
  *)
    notify normal "Do this: ${act_title:-next step}" "${act_body:-$note}"
    ;;
esac

printf '%s\n' "$kind"
