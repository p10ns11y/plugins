#!/usr/bin/env python3
import argparse
import subprocess
import sys
from collections import Counter
from pathlib import Path

CODE = {".py", ".js", ".jsx", ".mjs", ".cjs", ".ts", ".tsx", ".go", ".rs", ".c", ".cc", ".cpp", ".h", ".hpp", ".java", ".kt", ".rb", ".php", ".swift", ".cs", ".sh"}


def lines(path):
    return [l.strip() for l in Path(path).read_text(errors="ignore").splitlines() if l.strip()]


def ratio(files, k=4):
    docs = [lines(f) for f in files]
    seen = Counter(tuple(d[i:i + k]) for d in docs for i in range(len(d) - k + 1))
    dup = 0
    for d in docs:
        hit = set()
        for i in range(len(d) - k + 1):
            if seen[tuple(d[i:i + k])] > 1:
                hit.update(range(i, i + k))
        dup += len(hit)
    total = sum(len(d) for d in docs)
    return dup, total


def touched(rng):
    out = subprocess.run(["git", "diff", "--name-only", "--diff-filter=AM", rng], capture_output=True, text=True)
    if out.returncode:
        sys.exit(out.stderr.strip() or 2)
    return [f for f in out.stdout.split() if Path(f).suffix in CODE and Path(f).is_file()]


def main():
    a = argparse.ArgumentParser()
    a.add_argument("files", nargs="*")
    a.add_argument("--diff")
    a.add_argument("--limit", type=float, default=0.03)
    o = a.parse_args()
    files = o.files + (touched(o.diff) if o.diff else [])
    dup, total = ratio(files)
    r = dup / total if total else 0.0
    print(f"dup={100 * r:.1f}% limit={100 * o.limit:.1f}% files {len(files)} lines {total}")
    return 1 if r > o.limit else 0


if __name__ == "__main__":
    sys.exit(main())
