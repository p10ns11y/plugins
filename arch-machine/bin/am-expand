#!/usr/bin/env bash
# am-expand — pull/install expandable tier (consent-gated, fail closed).
set -euo pipefail
# shellcheck source=am-lib.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/am-lib.sh"

YES=0
DRY=0
TARGET=""

usage() {
  cat <<EOF
am-expand — agent-internal helper for /arch-expand
Usage: am-expand <profile|module> [--yes] [--dry-run]

Examples:
  am-expand security --dry-run
  am-expand security --yes
  am-expand ml-dev --yes

Without --yes: always fail closed (exit 2).
Never auto-installs full profiles without consent.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --yes|-y) YES=1; shift ;;
    --dry-run) DRY=1; shift ;;
    -h|--help) usage; exit 0 ;;
    -*)
      echo "unknown flag: $1" >&2
      exit 2
      ;;
    *)
      TARGET="$1"
      shift
      ;;
  esac
done

if [[ -z "$TARGET" ]]; then
  usage >&2
  exit 2
fi

if ! am_is_expandable "$TARGET"; then
  echo "not expandable (unknown profile/module): $TARGET" >&2
  echo "see core-map.json expandable.profiles / expandable.modules" >&2
  exit 2
fi

# Consent gate BEFORE any mutation or network
if [[ "$YES" -ne 1 ]]; then
  echo "consent_required: expand '$TARGET' needs --yes (fail closed)" >&2
  am_consent_gate expand || true
  exit 2
fi
am_consent_gate expand --yes

# Resolve kind
KIND=$(jq -r --arg n "$TARGET" '
  if (.expandable.profiles | has($n)) then "profile"
  elif (.expandable.modules | has($n)) then "module"
  else "unknown" end
' "$(am_core_map_path)")

if [[ "$DRY" -eq 1 ]]; then
  echo "dry-run: expand kind=$KIND target=$TARGET"
  if [[ "$KIND" == "profile" ]]; then
    echo "dry-run: would run install.sh --profile $TARGET (or tinfoil install --profile $TARGET)"
  else
    PATH_MOD=$(jq -r --arg n "$TARGET" '.expandable.modules[$n].path' "$(am_core_map_path)")
    echo "dry-run: would ensure module path $PATH_MOD present and invoke module installer if any"
  fi
  exit 0
fi

if ! repo="$(am_resolve_repo)"; then
  echo "arch-machine repo not found — /arch-init --yes first" >&2
  exit 1
fi

if [[ "$KIND" == "profile" ]]; then
  echo "expand profile: $TARGET from $repo"
  if command -v tinfoil >/dev/null 2>&1; then
    tinfoil install --profile "$TARGET" || (cd "$repo" && bash ./install.sh --profile "$TARGET")
  else
    (cd "$repo" && bash ./install.sh --profile "$TARGET")
  fi
  exit 0
fi

# module: ensure tree exists (already in full clone); document pull
PATH_MOD=$(jq -r --arg n "$TARGET" '.expandable.modules[$n].path' "$(am_core_map_path)")
if [[ -d "$repo/$PATH_MOD" ]]; then
  echo "module present: $repo/$PATH_MOD"
  if [[ -f "$repo/$PATH_MOD/install.sh" ]]; then
    echo "module has install.sh — not auto-running without profile (see module README)"
  fi
  echo "expand module tier: present (use profile install for full tool wiring)"
  exit 0
fi
echo "module path missing: $repo/$PATH_MOD — refresh clone (git pull) with consent" >&2
exit 1
