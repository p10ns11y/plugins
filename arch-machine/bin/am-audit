#!/usr/bin/env bash
# am-audit — read-only threat-focused audit (FSD-safe).
# Prefer repo maintenance/security-audit.sh (quiet malware/ports/supply/config format).
# Fallback: tinfoil audit when script/repo missing.
set -euo pipefail
# shellcheck source=am-lib.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/am-lib.sh"

TARGET="${1:-global}"

run_script_audit() {
  local repo="$1"
  local script="$repo/maintenance/security-audit.sh"
  [[ -f "$script" ]] || return 1
  export TINFOIL_ROOT="$repo"
  case "$TARGET" in
    global|""|--global)
      echo "running: bash maintenance/security-audit.sh --global  (repo=$repo)"
      bash "$script" --global
      ;;
    --dry-run|dry-run)
      echo "running: bash maintenance/security-audit.sh --global --dry-run"
      bash "$script" --global --dry-run
      ;;
    --verbose|-v)
      echo "running: bash maintenance/security-audit.sh --global --verbose"
      bash "$script" --global --verbose
      ;;
    *)
      # project path
      if [[ -d "$TARGET" || "$TARGET" == "." ]]; then
        echo "running: bash maintenance/security-audit.sh --project $TARGET"
        bash "$script" --project "$TARGET"
      else
        echo "running: bash maintenance/security-audit.sh --project $TARGET"
        bash "$script" --project "$TARGET"
      fi
      ;;
  esac
}

if repo="$(am_resolve_repo 2>/dev/null)"; then
  if run_script_audit "$repo"; then
    exit $?
  fi
  echo "note: security-audit.sh missing under $repo — trying tinfoil" >&2
fi

if command -v tinfoil >/dev/null 2>&1; then
  echo "running: tinfoil audit $TARGET  (fallback)"
  if [[ "$TARGET" == "global" || "$TARGET" == "--global" || -z "$TARGET" ]]; then
    tinfoil audit
  else
    tinfoil audit "$TARGET"
  fi
  exit $?
fi

echo "neither security-audit.sh repo nor tinfoil on PATH — run /arch-status or /arch-init first" >&2
exit 1
