import Base
import ./trust.bend as Trust

# Human claims. Proofs live in PROOF.bend and do not edit this file.
# A guide-layer invariant asks a person. The other four layers may hold.
# The load cap never returns more than four, and it does not shrink a smaller count.

law guide_asks:
  {Trust.verdict(Trust.Guide{}) == Trust.Ask{} : Trust.Verdict}

law shape_holds:
  {Trust.verdict(Trust.Shape{}) == Trust.Hold{} : Trust.Verdict}

law check_holds:
  {Trust.verdict(Trust.Check{}) == Trust.Hold{} : Trust.Verdict}

law watch_holds:
  {Trust.verdict(Trust.Watch{}) == Trust.Hold{} : Trust.Verdict}

law skill_holds:
  {Trust.verdict(Trust.Skill{}) == Trust.Hold{} : Trust.Verdict}

law four_hold:
  {Trust.four_holds() == ((Trust.Hold{}, Trust.Hold{}), (Trust.Hold{}, Trust.Hold{})) : (Trust.Verdict & Trust.Verdict) & (Trust.Verdict & Trust.Verdict)}

law cap_under_four:
  {Trust.cap4(3n) == 3n : Nat}

law cap_at_four:
  {Trust.cap4(4n) == 4n : Nat}

law cap_above_four:
  {Trust.cap4(8n) == 4n : Nat}
