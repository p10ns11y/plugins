import Base
import ./gate.bend as G

# Human claims. Proofs live in PROOF.bend and do not edit this file.
# A guide-layer invariant asks a person. The other four layers may hold.
# The load cap never returns more than four, and it does not shrink a smaller count.

law guide_asks:
  {G.gate(G.Guide{}) == G.Ask{} : G.Verdict}

law shape_holds:
  {G.gate(G.Shape{}) == G.Hold{} : G.Verdict}

law check_holds:
  {G.gate(G.Check{}) == G.Hold{} : G.Verdict}

law watch_holds:
  {G.gate(G.Watch{}) == G.Hold{} : G.Verdict}

law skill_holds:
  {G.gate(G.Skill{}) == G.Hold{} : G.Verdict}

law cap_under_four:
  {G.cap4(3n) == 3n : Nat}

law cap_at_four:
  {G.cap4(4n) == 4n : Nat}

law cap_above_four:
  {G.cap4(8n) == 4n : Nat}
