{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'if [ -n \"${CLAUDE_PLUGIN_ROOT}\" ]; then exec \"${CLAUDE_PLUGIN_ROOT}/bin/steer-accel-pretool.sh\"; fi; exec \"${GROK_PLUGIN_ROOT}/bin/steer-accel-pretool.sh\"'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
