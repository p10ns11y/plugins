{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'exec \"${1:-$2}/bin/steer-accel-pretool.sh\"' sh \"${CLAUDE_PLUGIN_ROOT}\" \"${GROK_PLUGIN_ROOT}\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
